# Frontend: public Render API origin, no trailing slash. Empty uses the local Vite proxy.
VITE_API_URL=
# Backend: exact frontend origin, no trailing slash. Local development permits ports 5173-5179.
FRONTEND_URL=http://localhost:5175
PORT=3001
# Bind locally by default. Render needs HOST=0.0.0.0.
HOST=127.0.0.1
LOG_LEVEL=info
# Optional API runtime connection: restricted NOINHERIT login, never a database owner/service role.
# Leave this line commented to use work/database/api.env in local development.
# DATABASE_URL=postgresql://runtime_login:encoded_password@host:5432/database
DATABASE_POOL_MAX=4
# Optional trusted CA file for remote PostgreSQL. Remote connections verify certificates.
# DATABASE_CA_CERT_FILE=/absolute/path/to/ca.pem
# Migration-only direct/session connection; never used by the running API.
# MIGRATION_DATABASE_URL=postgresql://migration_login:encoded_password@host:5432/database
# Managed owner sign-in. Leave both commented for the isolated local studio preview.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Used only by retained legacy tooling. Never prefix server secrets with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-side Shopify Storefront connection. Unset means labelled preview, no checkout.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
# Shopify admin → Settings → Notifications → Webhooks signing key. Enables
# verified order notifications at POST /api/webhooks/shopify.
SHOPIFY_WEBHOOK_SECRET=
# Optional exact merchant checkout hostname if Shopify returns a custom domain.
SHOPIFY_CHECKOUT_HOST=
