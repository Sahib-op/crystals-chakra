{
  "name": "crystals-chakra",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "pwsh -NoProfile -File scripts/start-local.ps1",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.js",
    "preview": "vite preview",
    "dev:api": "node --watch --env-file-if-exists=work/database/api.env --env-file-if-exists=.env server/index.js",
    "start:api": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "contracts:generate": "node scripts/generate-contracts.ts",
    "contracts:check": "node scripts/generate-contracts.ts --check",
    "test:db": "node --env-file-if-exists=work/database/.env --test tests/database/*.test.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:import-legacy": "node --env-file-if-exists=.env scripts/import-legacy.ts",
    "db:local:setup": "node --env-file=work/database/.env scripts/provision-local-db.ts",
    "dev:studio-auth": "node --env-file=work/database/.env scripts/fixtures/studio-auth.ts",
    "launch:check": "node scripts/launch-check.js",
    "preview:prod": "node scripts/serve-dist.js",
    "og:image": "node scripts/generate-og-image.js",
    "test:e2e": "playwright test",
    "check:budget": "node scripts/check-budget.js"
  },
  "dependencies": {
    "@fastify/cors": "11.4.3",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.5",
    "@fastify/type-provider-typebox": "6.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@supabase/supabase-js": "2.119.1",
    "@tanstack/react-query": "5.108.0",
    "fastify": "5.12.8",
    "jose": "6.2.18",
    "lucide-react": "^1.76.0",
    "motion": "14.14.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-helmet-async": "^3.1.0",
    "react-router-dom": "^7.18.6",
    "three": "^0.187.0",
    "typebox": "1.4.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "ajv": "8.20.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  }
}
